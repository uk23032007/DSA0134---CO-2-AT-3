#include<iostream>
using namespace std;

class Team
{
public:
    string name;
    int wins,draws,losses;

    int points()
    {
        return wins*3+draws;
    }
};

int main()
{
    Team t[3];

    t[0].name="India";
    t[0].wins=5;
    t[0].draws=1;
    t[0].losses=0;

    t[1].name="Australia";
    t[1].wins=4;
    t[1].draws=2;
    t[1].losses=0;

    t[2].name="England";
    t[2].wins=3;
    t[2].draws=1;
    t[2].losses=2;

    int maxPoints=0;
    string champion;

    for(int i=0;i<3;i++)
    {
        cout<<t[i].name<<" Points = "
            <<t[i].points()<<endl;

        if(t[i].points()>maxPoints)
        {
            maxPoints=t[i].points();
            champion=t[i].name;
        }
    }

    cout<<"\nChampion: "<<champion;

    return 0;
}
